+inline SpecPlan parseSpecSteps(const std::string& spec, double tx, double ty, double target_z) {
+  YAML::Node doc;
+  try { doc = YAML::Load(spec); }
+  catch (const YAML::Exception& e) { throw std::runtime_error(std::string("spec 不是合法的 JSON／yaml：") + e.what()); }
+  if (!doc.IsMap() || !doc["steps"] || !doc["steps"].IsSequence())
+    throw std::runtime_error("spec 要有 steps 陣列");
+  SpecPlan plan;
+  try {
+    YAML::Node tasks(YAML::NodeType::Sequence);
+    int k = 0;
+    for (const auto& step : doc["steps"]) {
+      ++k;
+      const std::string where = "spec 的第 " + std::to_string(k) + " 步";
+      const std::string action = req(step, "action", where).as<std::string>();
+      const YAML::Node loc = step["location"];
+      if (loc && !loc.IsMap()) throw std::runtime_error(where + "：location 要是 {x, y, z}");
+      if (k == 1 && action == "go_to") {
+        if (loc) plan.stand = std::make_pair(req(loc, "x", where + " location").as<double>(),
+                                             req(loc, "y", where + " location").as<double>());
+        continue;
+      }
+      YAML::Node t(YAML::NodeType::Map);
+      t["action"] = action;
