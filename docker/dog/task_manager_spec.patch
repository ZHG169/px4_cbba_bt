+// ───────────────── current_task.spec（2026-11-13，CBBA 協定版本 4）─────────────────
+
+// spec 照任務檔的 tasks 格式：解析成 Task（參數攤平），外部點照它做、最後補 report_result；站的位置和沒有 spec 時一樣
+TEST_F(TreeTest, SpecTasksReplaceTheFixedPtzInspect) {
+  const auto tasks = parseSpecTasks(
+      R"({"tasks": [{"action": "ptz_inspect", "target": {"x": 4, "y": 1, "z": 1.5}, "snapshots": 2},
+                    {"action": "ptz_inspect", "target": {"x": 5, "y": 1, "z": 0.5}}]})");
+  ASSERT_EQ(tasks.size(), 2u);
+  EXPECT_EQ(tasks[0].get("target.z"), "1.5");
+  EXPECT_EQ(tasks[0].get("snapshots"), "2");
+  auto w = makeExternalWaypoint("cbba_", 77, 3.0, 0.0, std::make_pair(0.0, 0.0), 1.5, 1.0, &tasks);
+  EXPECT_NEAR(w.x, 1.5, 1e-9); EXPECT_NEAR(w.yaw, 0.0, 1e-9);
+  ASSERT_EQ(w.tasks.size(), 3u);
+  EXPECT_EQ(w.tasks[0].get("target.x"), "4");
+  EXPECT_EQ(w.tasks[1].get("target.x"), "5");
+  EXPECT_EQ(w.tasks[2].action, "report_result");
+  EXPECT_EQ(w.tasks[2].get("task_id"), "77");
+  // yaml 也行；tasks 是空的 = 走到點就回報
+  EXPECT_TRUE(parseSpecTasks("tasks: []").empty());
+}
+
+// 不能用的 spec：丟例外（node 回 BAD_SPEC，reason PERMANENT）
+TEST_F(TreeTest, BadSpecIsRejected) {
+  EXPECT_THROW(parseSpecTasks("{not json"), std::runtime_error);
+  EXPECT_THROW(parseSpecTasks(R"({"steps": []})"), std::runtime_error);                  // 沒有 tasks
+  EXPECT_THROW(parseSpecTasks(R"({"tasks": [{"action": "fly"}]})"), std::runtime_error);  // 不在 kValidActions
+  EXPECT_THROW(parseSpecTasks(R"({"tasks": [{"action": "report_result"}]})"), std::runtime_error);   // 自動補的，不能寫
+  EXPECT_THROW(parseSpecTasks(R"({"tasks": [{"action": "ptz_inspect"}]})"), std::runtime_error);     // 缺 target
+  EXPECT_EQ(failureReason(false, "BAD_SPEC: spec 要有 tasks 陣列"), reason::PERMANENT);
+}
+
+// 帶 spec 的 cbba 點整個跑完：照 spec 的兩個 ptz_inspect、回報成功
+TEST_F(TreeTest, SpecWaypointRunsAndReports) {
+  build(); captureReports();
+  const auto tasks = parseSpecTasks(
+      R"({"tasks": [{"action": "ptz_inspect", "target": {"x": 9, "y": 9, "z": 1}},
+                    {"action": "ptz_inspect", "target": {"x": 9, "y": 8, "z": 1}}]})");
+  auto bb = tree_->rootBlackboard();
+  auto q  = bb->get<std::shared_ptr<std::deque<Waypoint>>>("waypoints");
+  uint64_t cur = 0;
+  insertExternal(*q, nullptr, makeExternalWaypoint("cbba_", 5, 9, 9, std::nullopt, 1.5, 1.0, &tasks), 5, cur);
+  bb->set("current_task_id", cur);
+  EXPECT_EQ(tree_->tickOnce(), BT::NodeStatus::FAILURE);   // 哨兵第一拍抄 id
+  EXPECT_EQ(runToEnd(), BT::NodeStatus::SUCCESS);
+  ASSERT_EQ(reports_.size(), 1u);
+  EXPECT_EQ(reports_[0].id, 5u); EXPECT_TRUE(reports_[0].ok);
+  EXPECT_EQ(outcomes()[0], "cbba_5/goto/OK");
+  EXPECT_EQ(outcomes()[1], "cbba_5/ptz_inspect/OK");
+  EXPECT_EQ(outcomes()[2], "cbba_5/ptz_inspect/OK");
+  EXPECT_EQ(outcomes()[3], "cbba_5/report_result/OK");
+}
