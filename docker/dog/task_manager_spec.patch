+// CBBA's current_task.spec (2026-11-13). `owner` prefixes the error messages ("waypoint 'B' 的", "spec 的"); throws std::runtime_error
+inline std::vector<Task> parseTasks(const YAML::Node& tasks, const std::string& owner) {
+  std::vector<Task> out;
+  int ti = 0;
+  for (auto t : tasks) {
+    ++ti;
+    Task task;
+    task.action = req(t, "action", owner + " task " + std::to_string(ti)).as<std::string>();
+
+    // reject unknown actions at load time
+    if (task.action.empty() ||
+        std::find(kValidActions.begin(), kValidActions.end(), task.action) ==
+            kValidActions.end()) {
+      std::string valid;
+      for (const auto& a : kValidActions)
+        valid += (valid.empty() ? "" : ", ") + a;
+      throw std::runtime_error(
+          owner + "第 " + std::to_string(ti) +
+          " 個 task（從 1 數起）：" +
+          (task.action.empty() ? std::string("action 是空字串")
+                               : "action '" + task.action + "' 不認得") +
+          "（合法：" + valid + "）");
+    }
+
+    for (auto kv : t) {
+      auto k = kv.first.as<std::string>();
+      if (k == "action") continue;
+      const std::string where = owner + "第 " + std::to_string(ti) + " 個 task：";
+      // flatten one-level maps: target: {x, y, z} -> target.x, target.y, target.z
+      if (kv.second.IsMap()) {
+        for (auto sub : kv.second) {
+          const std::string sk = k + "." + sub.first.as<std::string>();
+          if (!sub.second.IsScalar())
+            throw std::runtime_error(where + sk + " 只能是數字或字串");
+          task.params[sk] = sub.second.as<std::string>();
+        }
+      } else if (kv.second.IsScalar()) {
+        task.params[k] = kv.second.as<std::string>();
+      } else {
+        throw std::runtime_error(where + k + " 只能是數字、字串，或一層的表（像 target: {x, y, z}）");
+      }
+    }
+
+    // validate ptz params at load time with the same function the node uses
+    if (task.action == "inspect") {
