 // Action whitelist; keep in sync with the Switch cases in bt/mission.xml
 inline const std::vector<std::string> kValidActions = {"ptz_inspect"};
 
+// One `tasks` list → Task (action + flattened params), validated against kValidActions. Shared by the mission file and
+// CBBA's current_task.spec (2026-11-13). `owner` prefixes the error messages ("waypoint 'B' 的", "spec 的"); throws std::runtime_error
+inline std::vector<Task> parseTasks(const YAML::Node& tasks, const std::string& owner) {
+  std::vector<Task> out;
+  int ti = 0;
+  for (auto t : tasks) {
+    ++ti;
+    Task task;
+    task.action = req(t, "action", owner + " task " + std::to_string(ti)).as<std::string>();
+
+    // reject unknown actions at load time
+    if (task.action.empty() ||
+        std::find(kValidActions.begin(), kValidActions.end(), task.action) ==
+            kValidActions.end()) {
+      std::string valid;
+      for (const auto& a : kValidActions)
+        valid += (valid.empty() ? "" : ", ") + a;
+      throw std::runtime_error(
+          owner + "第 " + std::to_string(ti) +
+          " 個 task（從 1 數起）：" +
+          (task.action.empty() ? std::string("action 是空字串")
+                               : "action '" + task.action + "' 不認得") +
+          "（合法：" + valid + "）");
+    }
+
+    for (auto kv : t) {
+      auto k = kv.first.as<std::string>();
+      if (k == "action") continue;
+      const std::string where = owner + "第 " + std::to_string(ti) + " 個 task：";
+      // flatten one-level maps: target: {x, y, z} -> target.x, target.y, target.z
+      if (kv.second.IsMap()) {
+        for (auto sub : kv.second) {
+          const std::string sk = k + "." + sub.first.as<std::string>();
+          if (!sub.second.IsScalar())
+            throw std::runtime_error(where + sk + " 只能是數字或字串");
+          task.params[sk] = sub.second.as<std::string>();
+        }
+      } else if (kv.second.IsScalar()) {
+        task.params[k] = kv.second.as<std::string>();
+      } else {
+        throw std::runtime_error(where + k + " 只能是數字、字串，或一層的表（像 target: {x, y, z}）");
+      }
+    }
+
+    // validate ptz params at load time with the same function the node uses
+    if (task.action == "ptz_inspect") {
+      PtzInspectAction::Goal probe;
+      std::string why;
+      if (!fillPtzGoal(task, probe, why)) {
+        throw std::runtime_error(
+            owner + "第 " + std::to_string(ti) +
+            " 個 task（從 1 數起）：ptz_inspect 的參數不合法 —— " + why);
+      }
+    }
+
+    // per-task on_fail override
+    const auto of = task.params.find("on_fail");
+    if (of != task.params.end() &&
+        of->second != "skip_task" && of->second != "abort") {
+      throw std::runtime_error(
+          owner + "第 " + std::to_string(ti) +
+          " 個 task（從 1 數起）：on_fail '" + of->second +
+          "' 不認得（合法：skip_task, abort）");
+    }
+    out.push_back(task);
+  }
+  return out;
+}
+
+// current_task.spec (2026-11-13, CBBA 協定版本 4)：外部任務要做的事，格式同任務檔 waypoints[].tasks（MISSION_FORMAT.md）：
+//   {"tasks": [{"action": "ptz_inspect", "target": {"x": 3, "y": 1, "z": 1.5}, "snapshots": 1}, ...]}
+// JSON 或 yaml 都行。report_result 不寫，makeExternalWaypoint 自己補在最後。不合法時丟 std::runtime_error（呼叫端回 BAD_SPEC）
+inline std::vector<Task> parseSpecTasks(const std::string& spec) {
+  YAML::Node doc;
+  try { doc = YAML::Load(spec); }
+  catch (const YAML::Exception& e) { throw std::runtime_error(std::string("spec 不是合法的 JSON／yaml：") + e.what()); }
+  if (!doc.IsMap() || !doc["tasks"] || !doc["tasks"].IsSequence())
+    throw std::runtime_error("spec 要有 tasks 陣列");
+  try { return parseTasks(doc["tasks"], "spec 的"); }
+  catch (const YAML::Exception& e) { throw std::runtime_error(std::string("spec：") + e.what()); }
+}
