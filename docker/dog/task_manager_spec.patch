+// ───────────────── current_task.spec（2026-11-13，CBBA 協定版本 4）─────────────────
+
+// 通用 steps（2-1b 的 step.action）：第一步 go_to 是站的位置；inspect 的 location → 雲台 target、params 攤平；
+// 外部點照它做、最後補 report_result
+TEST_F(TreeTest, SpecStepsBecomeDogTasks) {
+  const auto plan = parseSpecSteps(
+      R"({"steps": [{"action": "go_to", "location": {"x": 3, "y": 0}},
+                    {"action": "inspect", "location": {"x": 4, "y": 1, "z": 1.5}, "params": {"snapshots": 2}},
+                    {"action": "inspect", "location": {"x": 5, "y": 1}}]})", 9.0, 9.0, 0.8);
+  ASSERT_TRUE(plan.stand);
+  EXPECT_DOUBLE_EQ(plan.stand->first, 3.0);
+  EXPECT_DOUBLE_EQ(plan.stand->second, 0.0);
+  ASSERT_EQ(plan.tasks.size(), 2u);   // go_to 變成站的位置，不是 task
+  EXPECT_EQ(plan.tasks[0].action, "inspect");
+  EXPECT_EQ(plan.tasks[0].get("target.z"), "1.5");
+  EXPECT_EQ(plan.tasks[0].get("snapshots"), "2");
+  EXPECT_EQ(plan.tasks[1].get("target.x"), "5");
+  EXPECT_EQ(plan.tasks[1].get("snapshots"), "1");   // 沒寫：拍 1 張
+  EXPECT_EQ(std::stod(plan.tasks[1].get("target.z")), 0.8);   // 沒給 z：用 target_z
+  auto w = makeExternalWaypoint("cbba_", 77, plan.stand->first, plan.stand->second, std::make_pair(0.0, 0.0), 1.5, 0.8,
+                                &plan.tasks);
+  EXPECT_NEAR(w.x, 1.5, 1e-9); EXPECT_NEAR(w.yaw, 0.0, 1e-9);
+  ASSERT_EQ(w.tasks.size(), 3u);
+  EXPECT_EQ(w.tasks[2].action, "report_result");
+  EXPECT_EQ(w.tasks[2].get("task_id"), "77");
+
+  // 沒有 go_to：站的位置用任務位置；inspect 沒給 location：看任務位置
+  const auto bare = parseSpecSteps(R"({"steps": [{"action": "inspect"}]})", 6.0, 2.0, 1.0);
+  EXPECT_FALSE(bare.stand);
+  ASSERT_EQ(bare.tasks.size(), 1u);
+  EXPECT_EQ(std::stod(bare.tasks[0].get("target.x")), 6.0);
+  EXPECT_EQ(std::stod(bare.tasks[0].get("target.y")), 2.0);
+  const auto look = parseSpecSteps(R"({"steps": [{"action": "inspect", "params": {"snapshots": 0}}]})", 0, 0, 1.0);
+  EXPECT_EQ(look.tasks[0].get("snapshots"), "0");   // 寫 0：只指向不拍
+  // steps 是空的 = 走到點就回報
+  EXPECT_TRUE(parseSpecSteps("steps: []", 0, 0, 1).tasks.empty());
+}
+
+// 不能用的 spec：丟例外（node 回 BAD_SPEC，reason PERMANENT）
+TEST_F(TreeTest, BadSpecIsRejected) {
+  EXPECT_THROW(parseSpecSteps("{not json", 0, 0, 1), std::runtime_error);
+  EXPECT_THROW(parseSpecSteps(R"({"tasks": []})", 0, 0, 1), std::runtime_error);                      // 舊格式：沒有 steps
+  EXPECT_THROW(parseSpecSteps(R"({"steps": [{"action": "fly"}]})", 0, 0, 1), std::runtime_error);     // 不在 kValidActions
+  EXPECT_THROW(parseSpecSteps(R"({"steps": [{"action": "ptz_inspect"}]})", 0, 0, 1), std::runtime_error);   // 舊名稱
+  EXPECT_THROW(parseSpecSteps(R"({"steps": [{"action": "report_result"}]})", 0, 0, 1), std::runtime_error); // 自動補的
+  EXPECT_THROW(parseSpecSteps(R"({"steps": [{"action": "inspect"}, {"action": "go_to"}]})", 0, 0, 1),
+               std::runtime_error);                                                                  // 中間的 go_to 狗還沒有
+  EXPECT_THROW(parseSpecSteps(R"({"steps": [{"action": "inspect", "location": 3}]})", 0, 0, 1), std::runtime_error);
+  EXPECT_EQ(failureReason(false, "BAD_SPEC: spec 要有 steps 陣列"), reason::PERMANENT);
+}
+
+// 帶 spec 的 cbba 點整個跑完：照 spec 的兩個 inspect、回報成功
+TEST_F(TreeTest, SpecWaypointRunsAndReports) {
+  build(); captureReports();
+  const auto plan = parseSpecSteps(
+      R"({"steps": [{"action": "inspect", "location": {"x": 9, "y": 9, "z": 1}},
+                    {"action": "inspect", "location": {"x": 9, "y": 8, "z": 1}}]})", 9, 9, 1.0);
+  auto bb = tree_->rootBlackboard();
+  auto q  = bb->get<std::shared_ptr<std::deque<Waypoint>>>("waypoints");
+  uint64_t cur = 0;
+  insertExternal(*q, nullptr, makeExternalWaypoint("cbba_", 5, 9, 9, std::nullopt, 1.5, 1.0, &plan.tasks), 5, cur);
+  bb->set("current_task_id", cur);
+  EXPECT_EQ(tree_->tickOnce(), BT::NodeStatus::FAILURE);   // 哨兵第一拍抄 id
+  EXPECT_EQ(runToEnd(), BT::NodeStatus::SUCCESS);
+  ASSERT_EQ(reports_.size(), 1u);
+  EXPECT_EQ(reports_[0].id, 5u); EXPECT_TRUE(reports_[0].ok);
+  EXPECT_EQ(outcomes()[0], "cbba_5/goto/OK");
+  EXPECT_EQ(outcomes()[1], "cbba_5/inspect/OK");
+  EXPECT_EQ(outcomes()[2], "cbba_5/inspect/OK");
+  EXPECT_EQ(outcomes()[3], "cbba_5/report_result/OK");
+}
+
+// 任務檔照舊能讀（解析抽成 parseTasks 之後）：不認得的 action 一樣擋，訊息帶點名
+TEST_F(TreeTest, MissionFileStillRejectsUnknownAction) {
+  const auto bad = variantYaml("spec_refactor", "inspect", "fly");
+  try {
+    loadMission(bad);
+    FAIL() << "應該丟例外";
+  } catch (const std::runtime_error& e) {
+    EXPECT_NE(std::string(e.what()).find("waypoint '"), std::string::npos) << e.what();
+    EXPECT_NE(std::string(e.what()).find("'fly' 不認得"), std::string::npos) << e.what();
+  }
+}
