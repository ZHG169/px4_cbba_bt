# ============================================================
#  CBBA_BT 模擬環境設定
#  改完後執行 ./start.sh，會自動重新產生 docker-compose.yaml
# ============================================================

COMPOSE_PROJECT_NAME=cbba_bt

# ---------- 無人機數量 ----------
# 1~9 台。每台會有自己的 uav 容器（uav1、uav2…）和自己的線材網路
UAV_COUNT=2

# ---------- ROS 2 ----------
ROS_DOMAIN_ID=42

# ---------- 版本 ----------
PX4_VERSION=v1.17.0
XRCE_AGENT_VERSION=v2.4.3

# ---------- 網路（假 IP）----------
# 所有 IP 依下面的規則由 gen_compose.py 自動算出，只需要改 NET_BASE：
#   mesh_net（無線電，加 tc）  ${NET_BASE}.0.0/24
#       uavN = ${NET_BASE}.0.(10+N)    gcs = ${NET_BASE}.0.100
#   sim_uavN_net（第 N 台的線）${NET_BASE}.N.0/24
#       sim  = ${NET_BASE}.N.2         uavN = ${NET_BASE}.N.11
# 例：UAV_COUNT=2 →
#   uav1 線 172.30.1.11 / mesh 172.30.0.11
#   uav2 線 172.30.2.11 / mesh 172.30.0.12
NET_BASE=172.30

# ---------- PX4 <-> XRCE Agent ----------
XRCE_AGENT_PORT=8888
# 機型名稱（ROMFS/px4fmu_common/init.d-posix/airframes 裡的名稱，去掉前面的數字）
PX4_SIM_MODEL=gz_x500_mono_cam_down
# 多台時，每台出生點在 y 方向的間隔（公尺）
UAV_SPAWN_SPACING=2.0
