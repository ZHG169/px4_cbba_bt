<?xml version="1.0"?>
<!-- 火點 F 的標記（2026-11-05）：和 task_marker_g／m／t 同一種單層圓盤（直徑 3 m、厚 3 cm、沒有碰撞），紅色。
     使用者：不要紅色、黃色疊在一起，簡單一個平面就好（取代同日做的兩層 fire_flame、之前的 fire_block 紅色方塊）。
     tag 101 由 patrol_scenario.sh 另外生成在頂面上方 2 mm（TAG_Z_FIRE 0.032）；火在設備頂上時整個生成在設備頂面 -->
<sdf version="1.9">
  <model name="task_marker_f">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.015 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>1.5</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.85 0.1 0.08 1</ambient><diffuse>0.85 0.1 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular><emissive>0.255 0.030 0.024 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
