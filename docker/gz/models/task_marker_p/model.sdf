<?xml version="1.0"?>
<!-- 狗的日常巡檢點 A1～、B1～、C1～ 的地面標記（2026-11-07）：紫色，和 CBBA 的任務（G 綠、M 藍、T 黃、F 紅）分開；
     巡檢會一直繞圈，做完不刪。直徑 2 m（比任務的 3 m 小，看得出是另一類），只有 visual，狗、無人機不會撞到；
     顏色和 docker/itest/label_gazebo.py、animate_demo.py 一致。由 patrol_scenario.sh mark-at … P 生成 -->
<sdf version="1.9">
  <model name="task_marker_p">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.015 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>1.0</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.56 0.27 0.68 1</ambient><diffuse>0.56 0.27 0.68 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular><emissive>0.168 0.081 0.204 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
