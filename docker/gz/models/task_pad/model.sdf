<?xml version="1.0"?>
<!-- 手動插入的任務點：藍色平台，插入時才生成（docker/scripts/patrol_scenario.sh mark-at，2026-10-14）。
     任務點同時起火時，火點方塊（fire_block 1.6 m）會蓋在上面 -->
<sdf version="1.9">
  <model name="task_pad">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.025 0 0 0</pose>
      <collision name="collision"><geometry><box><size>1.5 1.5 0.05</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>1.5 1.5 0.05</size></box></geometry>
        <material>
          <ambient>0.15 0.4 0.9 1</ambient><diffuse>0.15 0.4 0.9 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular><emissive>0.05 0.12 0.3 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
